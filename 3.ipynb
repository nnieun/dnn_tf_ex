   "source": [
    "# ensorFlow가 시작하자마자 GPU 메모리를 거의 전부 선점하는 것을 막고 필요한 만큼 점진적으로 확보하게 한\n",
    "import tensorflow as tf\n",
    "\n",
    "gpus = tf.config.list_physical_devices('GPU')\n",
    "\n",
    "for gpu in gpus:\n",
    "    tf.config.experimental.set_memory_growth(gpu, True)"
   ]
